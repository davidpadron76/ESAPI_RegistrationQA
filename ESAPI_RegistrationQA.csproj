<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <!--
    Path to the Varian assemblies.

    This used to be hard-coded as an absolute path in every <HintPath>, so the project only
    built on the one machine where Varian happened to be installed on that drive.

    It can be set explicitly in three ways, in order of precedence:
      1. /p:VarianScriptingPath=... on the MSBuild command line,
      2. a Directory.Build.props next to the solution (best left unversioned),
      3. the VarianScriptingPath environment variable.

    If none is set, the usual install locations are probed and the first one that actually
    contains VMS.IRS.Scripting.dll wins. Probing beats a single hard-coded default: an
    unresolved reference does not fail loudly, it makes ScriptContext vanish and surfaces as
    a confusing CS0246 in whichever file happens to name the type.
  -->
  <PropertyGroup>
    <VarianScriptingPath Condition=" '$(VarianScriptingPath)' == '' AND '$(VARIANSCRIPTINGPATH)' != '' ">$(VARIANSCRIPTINGPATH)</VarianScriptingPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(VarianScriptingPath)' == '' ">
    <_VarianProbe1>D:\Program Files (x86)\Varian\ProductLine\Workspaces\VMS.IRS.Workspace</_VarianProbe1>
    <_VarianProbe2>C:\Program Files (x86)\Varian\ProductLine\Workspaces\VMS.IRS.Workspace</_VarianProbe2>
    <_VarianProbe3>$(ProgramFiles) (x86)\Varian\ProductLine\Workspaces\VMS.IRS.Workspace</_VarianProbe3>
    <_VarianProbe4>D:\Program Files\Varian\ProductLine\Workspaces\VMS.IRS.Workspace</_VarianProbe4>
    <_VarianProbe5>C:\Program Files\Varian\ProductLine\Workspaces\VMS.IRS.Workspace</_VarianProbe5>

    <VarianScriptingPath Condition=" Exists('$(_VarianProbe1)\VMS.IRS.Scripting.dll') ">$(_VarianProbe1)</VarianScriptingPath>
    <VarianScriptingPath Condition=" '$(VarianScriptingPath)' == '' AND Exists('$(_VarianProbe2)\VMS.IRS.Scripting.dll') ">$(_VarianProbe2)</VarianScriptingPath>
    <VarianScriptingPath Condition=" '$(VarianScriptingPath)' == '' AND Exists('$(_VarianProbe3)\VMS.IRS.Scripting.dll') ">$(_VarianProbe3)</VarianScriptingPath>
    <VarianScriptingPath Condition=" '$(VarianScriptingPath)' == '' AND Exists('$(_VarianProbe4)\VMS.IRS.Scripting.dll') ">$(_VarianProbe4)</VarianScriptingPath>
    <VarianScriptingPath Condition=" '$(VarianScriptingPath)' == '' AND Exists('$(_VarianProbe5)\VMS.IRS.Scripting.dll') ">$(_VarianProbe5)</VarianScriptingPath>

    <!-- Nothing found: keep the historical path so the error message names a real candidate. -->
    <VarianScriptingPath Condition=" '$(VarianScriptingPath)' == '' ">$(_VarianProbe1)</VarianScriptingPath>
  </PropertyGroup>

  <!--
    Where the built assembly has to land for Eclipse to find it.

    The build output goes straight into the Eclipse plugins folder rather than into bin\.
    That is deliberate and was the original arrangement: Eclipse only lists scripts it finds
    in that directory, so building anywhere else means the plugin compiles cleanly and then
    cannot be invoked.

    The default resolves through $(USERPROFILE), so it works on any workstation without
    editing this file. Override it the same three ways as VarianScriptingPath:
      1. /p:EclipsePluginsPath=... on the MSBuild command line,
      2. a Directory.Build.props next to the solution,
      3. the EclipsePluginsPath environment variable.
  -->
  <PropertyGroup>
    <EclipsePluginsPath Condition=" '$(EclipsePluginsPath)' == '' AND '$(ECLIPSEPLUGINSPATH)' != '' ">$(ECLIPSEPLUGINSPATH)</EclipsePluginsPath>
    <EclipsePluginsPath Condition=" '$(EclipsePluginsPath)' == '' ">$(USERPROFILE)\Documents\Contouring Scripting API\Projects\plugins</EclipsePluginsPath>
  </PropertyGroup>

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{97BBA70E-D19C-4530-848B-3F2766BE9B6E}</ProjectGuid>
    <OutputType>library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>VMS.IRS.Scripting</RootNamespace>
    <AssemblyName>ESAPI_RegistrationQA</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <TargetFrameworkProfile />
    <!-- Pinned explicitly: the code uses C# 7 constructs (inline out, throw expressions,
         discards). Without this line the language version depends on the Visual Studio
         installation. -->
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <!-- Eclipse 15.6 and later are 64-bit processes: the plugin must match.
       The README said x64 while the project built as AnyCPU. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(EclipsePluginsPath)\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>$(EclipsePluginsPath)\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Xaml">
      <RequiredTargetFramework>4.0</RequiredTargetFramework>
    </Reference>
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="VMS.CA.Scripting">
      <HintPath>$(VarianScriptingPath)\VMS.CA.Scripting.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VMS.IRS.Scripting">
      <HintPath>$(VarianScriptingPath)\VMS.IRS.Scripting.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ESAPI_RegistrationQA.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />

    <Compile Include="Models\ImageGeometry.cs" />
    <Compile Include="Models\MetricCatalog.cs" />
    <Compile Include="Models\MetricResult.cs" />
    <Compile Include="Models\QaMeasurements.cs" />
    <Compile Include="Models\RegistrationContext.cs" />
    <Compile Include="Models\RigidTransform.cs" />
    <Compile Include="Models\RigidTransformItem.cs" />
    <Compile Include="Models\ThresholdProfile.cs" />
    <Compile Include="Models\Vec3.cs" />

    <Compile Include="Services\AdvisoryEngine.cs" />
    <Compile Include="Services\CsvDatasetExporter.cs" />
    <Compile Include="Services\DistanceTransform.cs" />
    <Compile Include="Services\StructureRasterizer.cs" />
    <Compile Include="Services\SurfaceMetrics.cs" />
    <Compile Include="Services\DiagnosticLog.cs" />
    <Compile Include="Services\Dyn.cs" />
    <Compile Include="Services\EsapiImageReader.cs" />
    <Compile Include="Services\HtmlReportBuilder.cs" />
    <Compile Include="Services\LandmarkExtractor.cs" />
    <Compile Include="Services\MatrixReader.cs" />
    <Compile Include="Services\MetricEvaluator.cs" />
    <Compile Include="Services\PointMapper.cs" />
    <Compile Include="Services\RegistrationAnalyzer.cs" />
    <Compile Include="Services\SampledVolume.cs" />
    <Compile Include="Services\SimilarityCalculator.cs" />
    <Compile Include="Services\VoxelPairSampler.cs" />

    <Compile Include="UI\MainControl.xaml.cs">
      <DependentUpon>MainControl.xaml</DependentUpon>
    </Compile>

    <Compile Include="ViewModels\MainViewModel.cs" />
    <Compile Include="ViewModels\RelayCommand.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="UI\MainControl.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!--
    Fail loudly when the Varian assemblies are missing.

    This is an Error, not a Warning, on purpose: a missing reference does not stop the build
    on its own, it just removes ScriptContext from the compilation and produces CS0246
    ("type or namespace not found") in whichever file names the type. That error points at
    the wrong place and sends you looking for a missing using directive. Naming the real
    cause here saves that detour.
  -->
  <!--
    State the destination in the build output.

    MSBuild creates the output directory tree silently, so a wrong EclipsePluginsPath does
    not fail the build: it produces a plugins folder somewhere unexpected and the assembly
    simply is not where Eclipse looks. Printing the path turns that from a hunt into a
    glance. It is a Message rather than a check because a different installation layout is
    legitimate and must not break the build.
  -->
  <Target Name="ReportPluginDestination" AfterTargets="Build">
    <Message Importance="high"
             Text="ESAPI_RegistrationQA.dll written to: $(EclipsePluginsPath)" />
    <Message Importance="high"
             Text="Eclipse lists scripts from this folder. Override with /p:EclipsePluginsPath=... if yours differs." />
  </Target>

  <Target Name="CheckVarianAssemblies" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="!Exists('$(VarianScriptingPath)\VMS.IRS.Scripting.dll')"
           Text="VMS.IRS.Scripting.dll was not found in '$(VarianScriptingPath)'. Set VarianScriptingPath to the Varian workspace directory via /p:VarianScriptingPath=..., a Directory.Build.props next to the solution, or the VarianScriptingPath environment variable. Without it ScriptContext cannot resolve and the build fails with a misleading CS0246." />
    <Warning Condition="!Exists('$(VarianScriptingPath)\VMS.CA.Scripting.dll')"
             Text="VMS.CA.Scripting.dll was not found in '$(VarianScriptingPath)'. The build may still succeed if no type from that assembly is used." />
  </Target>
</Project>
