<UserControl x:Class="ESAPI_RegistrationQA.UI.MainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="660" d:DesignWidth="920" Background="#F4F6F9">

    <UserControl.Resources>

        <!-- Semaphore palette. A single point of definition for all three tables. -->
        <SolidColorBrush x:Key="StatusGreenBg"  Color="#C8E6C9"/>
        <SolidColorBrush x:Key="StatusGreenFg"  Color="#2E7D32"/>
        <SolidColorBrush x:Key="StatusYellowBg" Color="#FFF9C4"/>
        <SolidColorBrush x:Key="StatusYellowFg" Color="#F57F17"/>
        <SolidColorBrush x:Key="StatusRedBg"    Color="#FFCDD2"/>
        <SolidColorBrush x:Key="StatusRedFg"    Color="#C62828"/>
        <SolidColorBrush x:Key="StatusNaBg"     Color="#ECEFF1"/>
        <SolidColorBrush x:Key="StatusNaFg"     Color="#546E7A"/>
        <SolidColorBrush x:Key="Accent"         Color="#005A9C"/>

        <!--
            Status badge.

            This block used to be duplicated verbatim across the three tables (roughly 165 of
            the file's 307 lines), with the risk of the copies drifting apart. It is now a
            single template referenced through CellTemplate. It includes the NotAvailable
            state, which the previous version did not cover.
        -->
        <DataTemplate x:Key="StatusBadgeTemplate">
            <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip="{Binding Tooltip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource StatusNaBg}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Green">
                                <Setter Property="Background" Value="{StaticResource StatusGreenBg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Yellow">
                                <Setter Property="Background" Value="{StaticResource StatusYellowBg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Red">
                                <Setter Property="Background" Value="{StaticResource StatusRedBg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource StatusNaFg}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Green">
                                    <Setter Property="Foreground" Value="{StaticResource StatusGreenFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Yellow">
                                    <Setter Property="Foreground" Value="{StaticResource StatusYellowFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Red">
                                    <Setter Property="Foreground" Value="{StaticResource StatusRedFg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <!--
            Metric name.

            The tooltip binds to the model's Tooltip property, which composes it from the
            metric catalog. It used to be eight DataTriggers comparing the exact display
            name: renaming a label made its tooltip disappear without warning.
        -->
        <DataTemplate x:Key="MetricNameTemplate">
            <TextBlock Text="{Binding MetricName}" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextWrapping="Wrap" ToolTip="{Binding Tooltip}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- Measured value. Shows "N/A" when there is no measurement, never a filler zero. -->
        <DataTemplate x:Key="MetricValueTemplate">
            <TextBlock Text="{Binding DisplayValue}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" ToolTip="{Binding Tooltip}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <Style x:Key="MetricGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <!--
            One line of context per metric: the tolerance it was held to, why it was held to
            none, or why there is no number. It replaces the criterion and reason columns,
            which between them never had the width to show either.
        -->
        <DataTemplate x:Key="MetricSummaryTemplate">
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="#546E7A" FontSize="11.5" ToolTip="{Binding Tooltip}"/>
        </DataTemplate>

        <!--
            The four metric sections rendered as one table with group headers. Four tabs meant
            four clicks to learn what had been measured, on a screen whose whole purpose is to
            be taken in at a glance.
        -->
        <CollectionViewSource x:Key="GroupedMetrics" Source="{Binding AllMetrics}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with anatomical profile selector -->
        <Border Grid.Row="0" Background="{StaticResource Accent}" Padding="12,10" CornerRadius="5" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="REGISTRATION QUANTITATIVE AUDIT (AAPM TG-132)"
                               Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Foreground="#DDE7F0" FontSize="11.5" Margin="0,3,0,0">
                        <Run Text="Patient:"/>
                        <Run Text="{Binding PatientId, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  ·  Modalities:"/>
                        <Run Text="{Binding RegContext.ModalityPair, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  ·  Type:"/>
                        <Run Text="{Binding RegContext.RegType, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Anatomical profile:" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5"/>
                    <ComboBox ItemsSource="{Binding AvailableProfiles}"
                              SelectedItem="{Binding ActiveProfile, Mode=TwoWay}"
                              DisplayMemberPath="ProfileName"
                              Width="175" Height="28"
                              VerticalContentAlignment="Center"
                              FontWeight="Bold" Foreground="{StaticResource Accent}" Background="White"
                              ToolTip="Changing profile only reclassifies the values already measured; it does not re-read the image."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Overall verdict, coloured by severity -->
        <Border Grid.Row="1" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource StatusNaBg}"/>
                    <Setter Property="BorderBrush" Value="#B0BEC5"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GlobalStatus}" Value="Green">
                            <Setter Property="Background" Value="#E8F5E9"/>
                            <Setter Property="BorderBrush" Value="#66BB6A"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GlobalStatus}" Value="Yellow">
                            <Setter Property="Background" Value="#FFFDE7"/>
                            <Setter Property="BorderBrush" Value="#FBC02D"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GlobalStatus}" Value="Red">
                            <Setter Property="Background" Value="#FFEBEE"/>
                            <Setter Property="BorderBrush" Value="#E57373"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding GlobalStatusMessage}" FontSize="12.5" FontWeight="SemiBold"
                       TextWrapping="Wrap" Foreground="#37474F"
                       ToolTip="{Binding MeasurementSummary}"/>
        </Border>

        <!--
            Everything that was measured, in one table.

            Advisories, diagnostics and the rigid transform used to be tabs. All three are
            reference material: needed when a number has to be explained, in the way and not
            read the rest of the time. They are a line of text and two buttons now.
        -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Source={StaticResource GroupedMetrics}}"
                  Style="{StaticResource MetricGridStyle}" Margin="0"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                       Foreground="{StaticResource Accent}" Margin="4,10,0,4"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Metric" Width="220"
                                        CellTemplate="{StaticResource MetricNameTemplate}"/>
                <DataGridTemplateColumn Header="Value" Width="110"
                                        CellTemplate="{StaticResource MetricValueTemplate}"/>
                <DataGridTemplateColumn Header="Status" Width="80"
                                        CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                <DataGridTemplateColumn Header="Criterion / reason" Width="*"
                                        CellTemplate="{StaticResource MetricSummaryTemplate}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding TransformSummary}" FontSize="11" Foreground="#546E7A"
                   Margin="2,10,0,0" TextWrapping="Wrap"
                   ToolTip="DICOM patient coordinates: X = left-right, Y = anterior-posterior, Z = cranio-caudal. Euler angles in the intrinsic Rz-Ry-Rx convention."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{Binding AdvisoriesButtonText}" Command="{Binding ShowAdvisoriesCommand}"
                    MinWidth="150" Height="35" Background="White" Foreground="#546E7A"
                    BorderBrush="#B0BEC5" BorderThickness="1" Margin="0,0,10,0" Padding="12,0"/>
            <Button Content="{Binding DiagnosticsButtonText}" Command="{Binding ShowDiagnosticsCommand}"
                    MinWidth="150" Height="35" Background="White" Foreground="#546E7A"
                    BorderBrush="#B0BEC5" BorderThickness="1" Margin="0,0,25,0" Padding="12,0"
                    ToolTip="Every property the plugin could not read from the API, with the operation and the exception."/>
            <Button Content="Add to dataset (CSV)" Command="{Binding ExportCsvCommand}"
                    Width="180" Height="35" Background="White" Foreground="{StaticResource Accent}"
                    FontWeight="Bold" BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                    Margin="0,0,10,0"
                    ToolTip="Appends this case to a cumulative CSV file. No patient identifier is written. Point every audit at the same file to build a local baseline."/>
            <Button Content="Export technical report (HTML)" Command="{Binding ExportReportCommand}"
                    Width="240" Height="35" Background="{StaticResource Accent}" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</UserControl>
