<UserControl x:Class="ESAPI_RegistrationQA.UI.MainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="880" Background="#F4F6F9">
    <UserControl.Resources>
        <!-- Estilo global para celdas con ToolTip dinámico según la métrica -->
        <Style x:Key="MetricNameStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MetricName}" Value="NMI">
                    <Setter Property="ToolTip" Value="Normalized Mutual Information (NMI):&#x0a;Measures statistical dependence between multimodal pixel intensities. High values indicate robust anatomical alignment."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetricName}" Value="NCC">
                    <Setter Property="ToolTip" Value="Normalized Cross Correlation (NCC):&#x0a;Measures linear intensity alignment in monomodal datasets. High values represent strong structural matching."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetricName}" Value="SSD">
                    <Setter Property="ToolTip" Value="Sum of Squared Differences (SSD):&#x0a;Calculates voxel-by-voxel intensity differences. Sensitive to local geometric errors or contrast variations."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetricName}" Value="Jacobian &lt; 0 (%)">
                    <Setter Property="ToolTip" Value="Jacobian Determinant Analysis:&#x0a;Evaluates topological integrity in the deformation vector field (DVF). Values &lt;= 0 indicate unphysical grid folding."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetricName}" Value="Max Displacement">
                    <Setter Property="ToolTip" Value="Maximum Displacement (mm):&#x0a;Represents the largest spatial vector distance moved by any voxel during non-rigid deformation."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetricName}" Value="Smoothness">
                    <Setter Property="ToolTip" Value="DVF Smoothness:&#x0a;Evaluates mathematical regularity and continuity of deformation vectors. High smoothness ensures realistic grid topology."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetricName}" Value="DSC (Dice Overlap)">
                    <Setter Property="ToolTip" Value="Dice Similarity Coefficient (DSC):&#x0a;Measures volumetric overlap between reference and mapped organ contours (0 to 1 range, ideal &gt;= 0.85)."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetricName}" Value="HD95 (Hausdorff)">
                    <Setter Property="ToolTip" Value="95% Hausdorff Distance (HD95):&#x0a;Evaluates maximum surface deviation excluding the worst 5% outliers (ideal &lt; 3.0 mm)."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header con Selector de Zona Anatómica / Perfil -->
        <Border Grid.Row="0" Background="#005A9C" Padding="12,10" CornerRadius="5" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="REGISTRATION QUANTITATIVE AUDIT (TG-233 / ESAPI)" 
                               Foreground="White" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="{Binding PatientId, StringFormat='Patient ID: {0}'}" 
                               Foreground="#E0E0E0" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Dropdown de Selección de Zona Anatómica -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Anatomical Site Profile:" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding AvailableProfiles}"
                              SelectedItem="{Binding ActiveProfile}"
                              DisplayMemberPath="ProfileName"
                              Width="170" Height="28" 
                              VerticalContentAlignment="Center" 
                              FontWeight="Bold" Foreground="#005A9C" Background="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Banner -->
        <Border Grid.Row="1" Background="#FFFDE7" BorderBrush="#FBC02D" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,15">
            <TextBlock Text="{Binding GlobalStatusMessage}" Foreground="#7F6000" FontSize="13" FontWeight="SemiBold"/>
        </Border>

        <!-- Multi-Tab Dashboard Container -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Similarity & Topology QA -->
            <TabItem Header="QA Summary &amp; Metrics">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Intensity Similarity Metrics -->
                    <GroupBox Grid.Column="0" Header="Intensity Similarity Metrics" FontWeight="Bold" Foreground="#005A9C">
                        <DataGrid ItemsSource="{Binding IntensityMetrics}" AutoGenerateColumns="False" IsReadOnly="True" Margin="5" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Metric" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MetricName}" Style="{StaticResource MetricNameStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat={}{0:F3}}" Width="70"/>
                                <DataGridTextColumn Header="Criteria" Binding="{Binding ThresholdCriteria}" Width="80"/>

                                <DataGridTemplateColumn Header="Status" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E0E0E0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Green">
                                                                <Setter Property="Background" Value="#C8E6C9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Yellow">
                                                                <Setter Property="Background" Value="#FFF9C4"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Red">
                                                                <Setter Property="Background" Value="#FFCDD2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#333333"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Green">
                                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Yellow">
                                                                    <Setter Property="Foreground" Value="#F57F17"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Red">
                                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Biomechanical Deformation Metrics -->
                    <GroupBox Grid.Column="2" Header="Deformation &amp; Topology Metrics" FontWeight="Bold" Foreground="#005A9C">
                        <DataGrid ItemsSource="{Binding DeformationMetrics}" AutoGenerateColumns="False" IsReadOnly="True" Margin="5" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Metric" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MetricName}" Style="{StaticResource MetricNameStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat={}{0:F3}}" Width="70"/>
                                <DataGridTextColumn Header="Criteria" Binding="{Binding ThresholdCriteria}" Width="80"/>

                                <DataGridTemplateColumn Header="Status" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E0E0E0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Green">
                                                                <Setter Property="Background" Value="#C8E6C9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Yellow">
                                                                <Setter Property="Background" Value="#FFF9C4"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Red">
                                                                <Setter Property="Background" Value="#FFCDD2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#333333"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Green">
                                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Yellow">
                                                                    <Setter Property="Foreground" Value="#F57F17"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Red">
                                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 2: Structure & Surface Alignment -->
            <TabItem Header="Structure &amp; Surface QA">
                <GroupBox Header="Anatomical Structure &amp; Surface Alignment (DSC / HD95)" Margin="0,10,0,0" FontWeight="Bold" Foreground="#005A9C">
                    <DataGrid ItemsSource="{Binding StructureQAMetrics}" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Anatomical Index" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MetricName}" Style="{StaticResource MetricNameStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Computed Value" Binding="{Binding Value, StringFormat={}{0:F3}}" Width="1*"/>
                            <DataGridTextColumn Header="Criteria" Binding="{Binding ThresholdCriteria}" Width="1*"/>

                            <DataGridTemplateColumn Header="Status" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Green">
                                                            <Setter Property="Background" Value="#C8E6C9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Yellow">
                                                            <Setter Property="Background" Value="#FFF9C4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Red">
                                                            <Setter Property="Background" Value="#FFCDD2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#333333"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Green">
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Yellow">
                                                                <Setter Property="Foreground" Value="#F57F17"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Red">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </TabItem>

            <!-- TAB 3: Rigid Spatial Transformation Matrix -->
            <TabItem Header="Rigid Matrix Parameters">
                <GroupBox Header="Rigid Transformation Vector (VMS.IRS)" Margin="0,10,0,0" FontWeight="Bold" Foreground="#005A9C">
                    <DataGrid ItemsSource="{Binding RigidTransformData}" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Spatial Parameter" Binding="{Binding Parameter}" Width="2*"/>
                            <DataGridTextColumn Header="Computed Value" Binding="{Binding Value, StringFormat={}{0:F3}}" Width="1*"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </TabItem>

        </TabControl>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Export Technical Report (HTML)" Command="{Binding ExportReportCommand}" 
                    Width="220" Height="35" Background="#005A9C" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</UserControl>