<UserControl x:Class="ESAPI_RegistrationQA.UI.MainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="660" d:DesignWidth="920" Background="#F4F6F9">

    <UserControl.Resources>

        <!-- Semaphore palette. A single point of definition for all three tables. -->
        <SolidColorBrush x:Key="StatusGreenBg"  Color="#C8E6C9"/>
        <SolidColorBrush x:Key="StatusGreenFg"  Color="#2E7D32"/>
        <SolidColorBrush x:Key="StatusYellowBg" Color="#FFF9C4"/>
        <SolidColorBrush x:Key="StatusYellowFg" Color="#F57F17"/>
        <SolidColorBrush x:Key="StatusRedBg"    Color="#FFCDD2"/>
        <SolidColorBrush x:Key="StatusRedFg"    Color="#C62828"/>
        <SolidColorBrush x:Key="StatusNaBg"     Color="#ECEFF1"/>
        <SolidColorBrush x:Key="StatusNaFg"     Color="#546E7A"/>
        <SolidColorBrush x:Key="Accent"         Color="#005A9C"/>

        <!--
            Status badge.

            This block used to be duplicated verbatim across the three tables (roughly 165 of
            the file's 307 lines), with the risk of the copies drifting apart. It is now a
            single template referenced through CellTemplate. It includes the NotAvailable
            state, which the previous version did not cover.
        -->
        <DataTemplate x:Key="StatusBadgeTemplate">
            <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip="{Binding Tooltip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource StatusNaBg}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Green">
                                <Setter Property="Background" Value="{StaticResource StatusGreenBg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Yellow">
                                <Setter Property="Background" Value="{StaticResource StatusYellowBg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Red">
                                <Setter Property="Background" Value="{StaticResource StatusRedBg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource StatusNaFg}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Green">
                                    <Setter Property="Foreground" Value="{StaticResource StatusGreenFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Yellow">
                                    <Setter Property="Foreground" Value="{StaticResource StatusYellowFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Red">
                                    <Setter Property="Foreground" Value="{StaticResource StatusRedFg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <!--
            Metric name.

            The tooltip binds to the model's Tooltip property, which composes it from the
            metric catalog. It used to be eight DataTriggers comparing the exact display
            name: renaming a label made its tooltip disappear without warning.
        -->
        <DataTemplate x:Key="MetricNameTemplate">
            <TextBlock Text="{Binding MetricName}" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextWrapping="Wrap" ToolTip="{Binding Tooltip}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- Measured value. Shows "N/A" when there is no measurement, never a filler zero. -->
        <DataTemplate x:Key="MetricValueTemplate">
            <TextBlock Text="{Binding DisplayValue}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" ToolTip="{Binding Tooltip}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <Style x:Key="MetricGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with anatomical profile selector -->
        <Border Grid.Row="0" Background="{StaticResource Accent}" Padding="12,10" CornerRadius="5" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="REGISTRATION QUANTITATIVE AUDIT (AAPM TG-132 / TG-233)"
                               Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Foreground="#DDE7F0" FontSize="11.5" Margin="0,3,0,0">
                        <Run Text="Patient:"/>
                        <Run Text="{Binding PatientId, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  ·  Modalities:"/>
                        <Run Text="{Binding RegContext.ModalityPair, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  ·  Type:"/>
                        <Run Text="{Binding RegContext.RegType, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Anatomical profile:" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5"/>
                    <ComboBox ItemsSource="{Binding AvailableProfiles}"
                              SelectedItem="{Binding ActiveProfile, Mode=TwoWay}"
                              DisplayMemberPath="ProfileName"
                              Width="175" Height="28"
                              VerticalContentAlignment="Center"
                              FontWeight="Bold" Foreground="{StaticResource Accent}" Background="White"
                              ToolTip="Changing profile only reclassifies the values already measured; it does not re-read the image."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Overall verdict, coloured by severity -->
        <Border Grid.Row="1" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource StatusNaBg}"/>
                    <Setter Property="BorderBrush" Value="#B0BEC5"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GlobalStatus}" Value="Green">
                            <Setter Property="Background" Value="#E8F5E9"/>
                            <Setter Property="BorderBrush" Value="#66BB6A"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GlobalStatus}" Value="Yellow">
                            <Setter Property="Background" Value="#FFFDE7"/>
                            <Setter Property="BorderBrush" Value="#FBC02D"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GlobalStatus}" Value="Red">
                            <Setter Property="Background" Value="#FFEBEE"/>
                            <Setter Property="BorderBrush" Value="#E57373"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding GlobalStatusMessage}" FontSize="12.5" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="#37474F"/>
                <TextBlock Text="{Binding MeasurementSummary}" FontSize="10.5" Foreground="#607D8B"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>

            <!-- Similarity and topology -->
            <TabItem Header="QA Metrics">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Intensity similarity">
                        <DataGrid ItemsSource="{Binding IntensityMetrics}" Style="{StaticResource MetricGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Metric" Width="*"
                                                        CellTemplate="{StaticResource MetricNameTemplate}"/>
                                <DataGridTemplateColumn Header="Value" Width="80"
                                                        CellTemplate="{StaticResource MetricValueTemplate}"/>
                                <DataGridTextColumn Header="Criterion" Binding="{Binding ThresholdCriteria}" Width="130"/>
                                <DataGridTemplateColumn Header="Status" Width="80"
                                                        CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Deformation and topology">
                        <DataGrid ItemsSource="{Binding DeformationMetrics}" Style="{StaticResource MetricGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Metric" Width="*"
                                                        CellTemplate="{StaticResource MetricNameTemplate}"/>
                                <DataGridTemplateColumn Header="Value" Width="80"
                                                        CellTemplate="{StaticResource MetricValueTemplate}"/>
                                <DataGridTextColumn Header="Criterion" Binding="{Binding ThresholdCriteria}" Width="130"/>
                                <DataGridTemplateColumn Header="Status" Width="80"
                                                        CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Structures -->
            <TabItem Header="Structures &amp; Surface">
                <GroupBox Header="Anatomical alignment (DSC / HD95)" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding StructureQAMetrics}" Style="{StaticResource MetricGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Anatomical index" Width="2*"
                                                    CellTemplate="{StaticResource MetricNameTemplate}"/>
                            <DataGridTemplateColumn Header="Value" Width="100"
                                                    CellTemplate="{StaticResource MetricValueTemplate}"/>
                            <DataGridTextColumn Header="Criterion" Binding="{Binding ThresholdCriteria}" Width="160"/>
                            <DataGridTemplateColumn Header="Status" Width="80"
                                                    CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding UnavailableReason}" Width="3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="#777777"/>
                                        <Setter Property="FontSize" Value="10.5"/>
                                        <Setter Property="Margin" Value="0,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </TabItem>

            <!-- Rigid transform -->
            <TabItem Header="Rigid Transform">
                <GroupBox Header="Spatial parameters (DICOM patient coordinates)" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="10,6,10,0" TextWrapping="Wrap"
                                   FontWeight="Normal" FontSize="10.5" Foreground="#607D8B"
                                   Text="X = left-right (LR) · Y = anterior-posterior (AP) · Z = cranio-caudal (CC). Euler angles in the intrinsic Rz·Ry·Rx convention."/>
                        <DataGrid ItemsSource="{Binding RigidTransformData}" Style="{StaticResource MetricGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="2*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="1*"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                                <DataGridTextColumn Header="Provenance" Binding="{Binding Note}" Width="3*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Foreground" Value="#777777"/>
                                            <Setter Property="FontSize" Value="10.5"/>
                                            <Setter Property="Margin" Value="0,4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </TabItem>

            <!-- Clinical advisories -->
            <TabItem Header="Advisories">
                <GroupBox Header="Clinical advisories for the active profile" Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding Advisories}" Style="{StaticResource MetricGridStyle}"
                              RowHeight="NaN">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding SeverityText}" Width="90"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Category}" Width="180"/>
                            <DataGridTextColumn Header="Observation" Binding="{Binding Message}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Margin" Value="0,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </TabItem>

            <!--
                Diagnostics.

                A new tab: it surfaces everything the previous version swallowed in empty
                catch blocks. This is what lets the user find out why a metric came out
                unavailable.
            -->
            <TabItem Header="Diagnostics">
                <GroupBox Header="Varian API access" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DiagnosticsSummary}"
                                   Margin="10,6,10,0" FontWeight="SemiBold" FontSize="11"
                                   Foreground="#607D8B" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Diagnostics}" Style="{StaticResource MetricGridStyle}"
                                  RowHeight="NaN">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Level" Binding="{Binding LevelText}" Width="80"/>
                                <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="2*"/>
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Margin" Value="0,4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Export technical report (HTML)" Command="{Binding ExportReportCommand}"
                    Width="240" Height="35" Background="{StaticResource Accent}" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</UserControl>
